{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "tasks": {
    "codegen": {
      "inputs": [
        "openapi-ts.config.ts",
        "src/runtime-config.ts",
        "src/sonar/runtime-config.ts",
        "specs/openapi.v2.json",
        "specs/sonar.v1.json"
      ],
      "outputs": ["src/client/**", "src/sonar/client/**"]
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", "resources/openapi.v2.json"]
    },
    "type-check": {
      "dependsOn": ["^build", "codegen"]
    },
    "clean": {
      "cache": false
    }
  }
}
